#!/command/with-contenv bash
set -euo pipefail

COMFY_DIR="${COMFYUI_PATH:-/opt/ComfyUI}"
PORT="${COMFYUI_PORT:-8188}"
PUID="${PUID:-1000}"
PGID="${PGID:-1000}"

echo "[svc-comfyui] Python: $("${VENV:-/opt/venv}"/bin/python --version)"
echo "[svc-comfyui] Torch:  $("${VENV:-/opt/venv}"/bin/python -c 'import torch; print(torch.__version__)')"

# Hugging Face auth (optional). See docs/models.md for the full behavior.
if [[ -n "${HF_TOKEN_FILE:-}" && -f "${HF_TOKEN_FILE}" ]]; then
    export HF_TOKEN="$(cat "${HF_TOKEN_FILE}")"
fi
if [[ -n "${HF_TOKEN:-}" ]]; then
    echo "[svc-comfyui] Logging into Hugging Face..."
    gosu comfy "${VENV:-/opt/venv}/bin/hf" auth login --token "${HF_TOKEN}" --no-add-to-git-credential || \
        echo "[svc-comfyui] WARNING: Hugging Face login failed, continuing without it"
else
    echo "[svc-comfyui] No HF token set — Hugging Face downloads will be anonymous/rate-limited"
fi

# CivitAI auth (optional, exported for pull-model and any custom node that
# reads it). CivitAI has no login call to make — it's a plain API-token
# query param — so we just make sure the env var is populated.
if [[ -n "${CIVITAI_TOKEN_FILE:-}" && -f "${CIVITAI_TOKEN_FILE}" ]]; then
    export CIVITAI_API_TOKEN="$(cat "${CIVITAI_TOKEN_FILE}")"
fi
if [[ -n "${CIVITAI_API_TOKEN:-}" ]]; then
    echo "[svc-comfyui] CivitAI token set"
else
    echo "[svc-comfyui] No CivitAI token set — gated CivitAI model downloads will fail"
fi

# ComfyUI-Manager v4+ ships as a pip package (`comfyui-manager`), not a
# custom_nodes/ git-clone folder — v4's repo has no top-level __init__.py at
# all (moved under comfyui_manager/), so a naive "clone if __init__.py
# missing" check sees v4 as "corrupted" and silently resets it back to the
# old pre-v4 ltdrdata/ComfyUI-Manager `main` branch (3.x line) on every
# restart. `pip install -U --pre comfyui-manager` is also literally what
# ComfyUI's own "missing node packs" dialog tells operators to run.
# Idempotent: pip no-ops once already at the latest version.
echo "[svc-comfyui] Ensuring comfyui-manager (v4+) pip package is up to date..."
gosu comfy "${VENV:-/opt/venv}/bin/pip" install -q -U --pre comfyui-manager || \
    echo "[svc-comfyui] WARNING: comfyui-manager pip install/upgrade failed, continuing with whatever version is present"

# Remove any leftover pre-v4 git-clone install under /custom_nodes — it has
# no __init__.py in v4 either way, so ComfyUI can't load it as a node pack;
# keeping it around just wastes a requirements-install pass every restart
# for nothing (and can shadow the real pip package with a stale one).
if [[ -d "/custom_nodes/ComfyUI-Manager" ]]; then
    echo "[svc-comfyui] Removing legacy /custom_nodes/ComfyUI-Manager git-clone (superseded by pip package)"
    rm -rf "/custom_nodes/ComfyUI-Manager"
fi

# Anything a custom node's requirements.txt declares can shadow torch in
# the venv (pip installs custom node deps straight into the same venv
# ComfyUI/SageAttention run from — there's no separate PYTHONPATH overlay
# here), so protect the pinned build: never let
# torch/torchvision/torchaudio/pip/setuptools/wheel be reinstalled from a
# custom node's requirements file. An unpinned `torch` line in a custom
# node's requirements.txt has previously pulled in a newer torch and broken
# SageAttention with
# "undefined symbol: ...materialize_cow_storage..." (SageAttention's
# compiled .so is built against the exact pinned torch ABI).
PROTECTED_PKGS_REGEX='^(torch|torchvision|torchaudio|pip|setuptools|wheel)([<>=!~ ;].*)?$'

# pip constraints file: pins the resolver to the ALREADY-INSTALLED
# torch/torchvision/torchaudio versions for any *transitive* dependency
# (e.g. transformers/accelerate declare torch as a transitive requirement —
# stripping an explicit top-level `torch` line from a requirements file is
# NOT enough to stop pip from resolving + installing a different torch via
# a transitive path).
CONSTRAINTS_FILE="/tmp/pip-constraints.txt"
"${VENV:-/opt/venv}/bin/pip" freeze 2>/dev/null | grep -iE '^(torch|torchvision|torchaudio)==' > "$CONSTRAINTS_FILE" || true

for req in /custom_nodes/*/requirements*.txt; do
    [[ -f "$req" ]] || continue
    echo "[svc-comfyui] Installing custom node deps from: $req"

    filtered_req="$(mktemp)"
    # Normalize CRLF -> LF first: a stray \r (Windows line endings, seen in
    # the wild in real custom-node requirements files) breaks the `$`
    # anchor in PROTECTED_PKGS_REGEX and lets a "torch\r" line slip through
    # unfiltered.
    tr -d '\r' < "$req" > "${filtered_req}.normalized"
    grep -viE "$PROTECTED_PKGS_REGEX" "${filtered_req}.normalized" > "$filtered_req" || true
    skipped="$(grep -iE "$PROTECTED_PKGS_REGEX" "${filtered_req}.normalized" || true)"
    rm -f "${filtered_req}.normalized"
    if [[ -n "$skipped" ]]; then
        echo "[svc-comfyui]   skipping protected/base-image package(s) (would shadow pinned versions): $(echo "$skipped" | tr '\n' ' ')"
    fi

    if gosu comfy "${VENV:-/opt/venv}/bin/pip" install -q -c "$CONSTRAINTS_FILE" -r "$filtered_req"; then
        :
    else
        # A single unresolvable/unavailable line makes `pip install -r`
        # abort the WHOLE file atomically — none of the other, perfectly
        # installable packages get in either. Retry package-by-package so
        # one bad line doesn't block everything else the node needs.
        echo "[svc-comfyui]   Batch install failed — retrying package-by-package (skipping only the lines that fail)"
        while IFS= read -r line; do
            line_trimmed="$(echo "$line" | sed 's/#.*//' | xargs)"
            [[ -z "$line_trimmed" ]] && continue
            if gosu comfy "${VENV:-/opt/venv}/bin/pip" install -q -c "$CONSTRAINTS_FILE" "$line_trimmed" 2>/tmp/pip_line_err.log; then
                :
            else
                echo "[svc-comfyui]     SKIPPED (unavailable): $line_trimmed — $(tail -1 /tmp/pip_line_err.log)"
            fi
        done < "$filtered_req"
    fi
    rm -f "$filtered_req"
done

SAGE_FLAG=""
if [[ "${ENABLE_SAGE_ATTENTION:-true}" == "true" ]]; then
    SAGE_FLAG="--use-sage-attention"
fi

# extra_model_paths.yaml lets ComfyUI read models from /models (the bind
# mount) while keeping its own tree under /opt/ComfyUI intact for
# custom-node code that expects a real ComfyUI checkout layout.
cat > /tmp/extra_model_paths.yaml <<EOF
comfyui-docker:
    base_path: /
    is_default: true
    checkpoints: models/checkpoints
    clip: models/clip
    clip_vision: models/clip_vision
    configs: models/configs
    controlnet: models/controlnet
    diffusers: models/diffusers
    diffusion_models: models/diffusion_models
    embeddings: models/embeddings
    gligen: models/gligen
    hypernetworks: models/hypernetworks
    latent_upscale_models: models/latent_upscale_models
    loras: models/loras
    model_patches: models/model_patches
    photomaker: models/photomaker
    style_models: models/style_models
    text_encoders: models/text_encoders
    unet: models/unet
    upscale_models: models/upscale_models
    vae: models/vae
    vae_approx: models/vae_approx
    audio_encoders: models/audio_encoders
    custom_nodes: custom_nodes
    input: input
    output: output
EOF

echo "[svc-comfyui] Starting ComfyUI on port ${PORT} (sage attention: ${ENABLE_SAGE_ATTENTION:-true})"
exec gosu comfy "${VENV:-/opt/venv}/bin/python" "${COMFY_DIR}/main.py" \
    --listen 0.0.0.0 \
    --port "${PORT}" \
    --user-directory /config \
    --extra-model-paths-config /tmp/extra_model_paths.yaml \
    --disable-pinned-memory \
    --enable-manager \
    ${SAGE_FLAG} \
    ${COMFYUI_EXTRA_ARGS:-}
